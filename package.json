{
  "name": "lutris-library-browser",
  "version": "0.1.0",
  "description": "A local-first, read-only web browser for game libraries connected to Lutris.",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/ShivWad/lutris-web.git"
  },
  "homepage": "https://github.com/ShivWad/lutris-web#readme",
  "bugs": {
    "url": "https://github.com/ShivWad/lutris-web/issues"
  },
  "keywords": [
    "lutris",
    "game-library",
    "nextjs",
    "linux"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 5000",
    "build": "next build && node scripts/package-notices.mjs",
    "start": "next start --hostname 127.0.0.1 --port 5000",
    "lint": "eslint .",
    "test": "vitest run",
    "test:smoke": "node scripts/smoke-test.mjs && node scripts/smoke-test.mjs --host",
    "host:bridge": "node scripts/host-bridge.mjs",
    "host:install": "node scripts/install-host-bridge.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "check:public": "node scripts/check-public-files.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.2.8",
    "@fontsource-variable/manrope": "^5.2.8",
    "@tailwindcss/postcss": "^4.0.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.27",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.27",
    "typescript": "^5.7.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.17.1"
}
