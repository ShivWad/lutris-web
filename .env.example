# Host port published by Docker Compose.
PORT=5000

# Set to 1 for labeled in-memory demo data.
LUTRIS_DEMO=0

# Fixed path inside the container. ./imports is mounted at /imports read-only.
LUTRIS_IMPORT_FILE=/imports/library.json

# For compose.host.yaml: group ID of the host user running the Lutris helper.
LUTRIS_HOST_GID=1000
